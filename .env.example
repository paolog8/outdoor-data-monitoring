# Copy to .env and fill in. .env is not committed.

# Database
POSTGRES_DB=outdoor_monitoring
POSTGRES_USER=
POSTGRES_PASSWORD=

# SymmetricDS replication to the hub
SYM_PASSWORD=
SYM_SERVER_ADDRESS=
SYM_SERVER_PORT=

# Optional
# Grafana admin password (defaults to "admin" if unset)
GRAFANA_PASSWORD=
# Base URL of the hub's Grafana, for "Open in Grafana" links, e.g. https://<hub-host>
GRAFANA_BASE_URL=
# Set to true to preview ingestion without writing
DRY_RUN=false
