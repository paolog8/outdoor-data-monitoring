    {
      "id": 9,
      "title": "Daily Energy Yield",
      "description": "Energy produced per cm² per day (mpp_tracking periods only), from hourly server-side buckets. Days with partial data show only the recorded energy.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  time_bucket('1 day', m.measured_at) AS time,\n  SUM(m.power_mw) / sc.area_cm2 AS \"Energy Yield\"\nFROM mpp_measurements_for_cell('$cell', $__timeFrom(), $__timeTo(), INTERVAL '1 hour') m\nCROSS JOIN (SELECT area_cm2 FROM solar_cell WHERE name = '$cell') sc\nWHERE m.mode_code = 'mpp_tracking'\nGROUP BY 1, sc.area_cm2\nORDER BY 1"
        }
      ],
