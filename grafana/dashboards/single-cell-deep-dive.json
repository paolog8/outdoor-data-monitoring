        "enable": true,
        "hide": false,
        "iconColor": "#FF9830",
        "name": "Connection events",
        "target": {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  e.occurred_at AS time,\n  e.event_type || ' — ' || t.name || '/' || s.slot_code ||\n    COALESCE(' (' || mcm.code || COALESCE(', ' || mp.code, '') || ')', '') AS text,\n  e.event_type AS tags\nFROM mpp_connection_event e\nJOIN solar_cell sc ON sc.id = e.solar_cell_id\nJOIN mpp_tracking_slot s ON s.id = e.mpp_tracking_slot_id\nJOIN mpp_tracker t ON t.id = s.mpp_tracker_id\nLEFT JOIN mpp_connection_mode mcm ON mcm.id = e.mode_id\nLEFT JOIN mpp_polarity mp ON mp.id = e.polarity_id\nWHERE sc.name = '$cell'\n  AND $__timeFilter(e.occurred_at)",
          "refId": "Anno"
        }
      }
    ]
  },
  "description": "Per-cell deep dive — power, voltage, current and power-conversion efficiency (PCE) for a single selected solar cell, scoped to its active connection intervals.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Cell Details",
      "description": "Registry metadata for the selected cell",
      "type": "table",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT\n  sc.name              AS \"Cell\",\n  sct.code             AS \"Type\",\n  sc.structure         AS \"Structure\",\n  sc.area_cm2          AS \"Area (cm²)\",\n  sc.initial_pce       AS \"Initial PCE (%)\",\n  man.name             AS \"Manufacturer\",\n  own.name             AS \"Owner\",\n  sc.id_pvcomb         AS \"PVcomB ID\",\n  act.first_conn       AS \"Active From\",\n  act.last_event       AS \"Active Until\",\n  sc.nomad_entry_url   AS \"NOMAD\"\nFROM solar_cell sc\nLEFT JOIN solar_cell_type sct ON sct.id = sc.cell_type_id\nLEFT JOIN scientist man       ON man.id = sc.manufacturer_id\nLEFT JOIN scientist own       ON own.id = sc.owner_id\nLEFT JOIN LATERAL (\n  SELECT MIN(occurred_at) AS first_conn, MAX(occurred_at) AS last_event\n  FROM mpp_connection_event ce\n  WHERE ce.solar_cell_id = sc.id\n) act ON true\nWHERE sc.name = '$cell'",
          "format": "table"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "showHeader": true
      },
