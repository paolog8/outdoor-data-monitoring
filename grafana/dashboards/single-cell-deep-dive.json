    {
      "id": 8,
      "title": "Power Conversion Efficiency (PCE)",
      "description": "PCE(%) = 1000 × P[mW] / (irradiance[W/m²] × area[cm²]), using the cell's registered area and global irradiance. MPP-tracking mode only, irradiance > $min_irr W/m² to suppress low-light noise. Buckets aligned to the panel interval.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "WITH p AS (\n  SELECT mfc.measured_at AS t, mfc.power_mw\n  FROM mpp_measurements_for_cell('$cell', $__timeFrom(), $__timeTo(), INTERVAL '1 millisecond' * $__interval_ms) mfc\n  WHERE mfc.mode_code = 'mpp_tracking'\n),\nirr AS (\n  SELECT\n    time_bucket(INTERVAL '1 millisecond' * $__interval_ms, time) AS t,\n    AVG(irradiance) AS irr\n  FROM irradiance_measurement\n  WHERE $__timeFilter(time)\n    AND irradiance > $min_irr\n  GROUP BY 1\n),\narea AS (SELECT area_cm2 FROM solar_cell WHERE name = '$cell')\nSELECT\n  p.t AS time,\n  1000.0 * p.power_mw / NULLIF(irr.irr * a.area_cm2, 0) AS \"PCE (%)\"\nFROM p\nJOIN irr ON p.t = irr.t\nCROSS JOIN area a\nORDER BY 1",
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
