    {
      "id": 4,
      "title": "Average PCE",
      "description": "Mean power-conversion efficiency over the range. PCE(%) = 1000 × P[mW] / (irradiance[W/m²] × area[cm²]). MPP-tracking mode only, irradiance > $min_irr W/m².",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "WITH p AS (\n  SELECT mfc.measured_at AS t, mfc.power_mw\n  FROM mpp_measurements_for_cell('$cell', $__timeFrom(), $__timeTo(), INTERVAL '1 millisecond' * $__interval_ms) mfc\n  WHERE mfc.mode_code = 'mpp_tracking'\n),\nirr AS (\n  SELECT time_bucket(INTERVAL '1 millisecond' * $__interval_ms, time) AS t, AVG(irradiance) AS irr\n  FROM irradiance_measurement\n  WHERE $__timeFilter(time) AND irradiance > $min_irr\n  GROUP BY 1\n),\narea AS (SELECT area_cm2 FROM solar_cell WHERE name = '$cell')\nSELECT AVG(1000.0 * p.power_mw / NULLIF(irr.irr * a.area_cm2, 0)) AS value\nFROM p JOIN irr ON p.t = irr.t CROSS JOIN area a",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
