    {
      "id": 1,
      "title": "Active Cells",
      "description": "Solar cells currently in a connected state",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT COUNT(*) AS value\nFROM (\n  SELECT DISTINCT ON (mpp_tracking_slot_id) event_type\n  FROM mpp_connection_event\n  WHERE occurred_at <= $__timeTo()\n  ORDER BY mpp_tracking_slot_id, occurred_at DESC\n) latest\nWHERE event_type = 'connection'",
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
