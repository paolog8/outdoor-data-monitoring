    {
      "id": 5,
      "title": "Power per Cell",
      "description": "Average power of each connected cell, 5-minute buckets. Measurements are attributed to cells via their connection intervals, so a missing or flat trace immediately shows which cell stopped producing.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "WITH connection_intervals AS (\n  SELECT\n    e.mpp_tracking_slot_id,\n    e.solar_cell_id,\n    e.event_type,\n    e.occurred_at AS connected_at,\n    LEAD(e.occurred_at) OVER (\n      PARTITION BY e.mpp_tracking_slot_id ORDER BY e.occurred_at\n    ) AS next_event_at\n  FROM mpp_connection_event e\n)\nSELECT\n  time_bucket('5 minutes', m.time) AS time,\n  sc.name AS metric,\n  AVG(m.power) AS \"Power\"\nFROM connection_intervals ci\nJOIN solar_cell sc ON sc.id = ci.solar_cell_id\nJOIN mpp_measurement m\n  ON m.mpp_tracking_slot_id = ci.mpp_tracking_slot_id\n AND m.time >= ci.connected_at\n AND (ci.next_event_at IS NULL OR m.time < ci.next_event_at)\nWHERE ci.event_type = 'connection'\n  AND $__timeFilter(m.time)\nGROUP BY 1, 2\nORDER BY 1, 2",
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Power (mW)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 5,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "mwatt"
        },
        "overrides": []
      }
    },
