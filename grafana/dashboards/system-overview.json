    {
      "id": 2,
      "title": "Data Freshness",
      "description": "Age of the most recent MPP, irradiance, and temperature data at the end of the selected time range. Large values mean the export/ingestion pipeline or SymmetricDS replication has stalled. Data arrives in periodic bulk exports, so an age of hours to a few days is normal.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 9,
        "x": 3,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM ($__timeTo() - MAX(time))) AS \"MPP\"\nFROM mpp_measurement\nWHERE time <= $__timeTo()",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM ($__timeTo() - MAX(time))) AS \"Irradiance\"\nFROM irradiance_measurement\nWHERE time <= $__timeTo()",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT EXTRACT(EPOCH FROM ($__timeTo() - MAX(time))) AS \"Temperature\"\nFROM temperature_measurement\nWHERE time <= $__timeTo()",
          "format": "table"
        }
      ],
