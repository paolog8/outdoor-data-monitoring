    {
      "id": 9,
      "title": "Ingestion Runs (edge)",
      "description": "Recent ingestion_log entries replicated from the measurement PC. A 'failed' row means an export folder did not ingest — fix it on the edge and re-run.",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "format": "table",
          "rawSql": "SELECT\n  started_at    AS \"Started\",\n  folder_name   AS \"Folder / File\",\n  status        AS \"Status\",\n  completed_at  AS \"Completed\",\n  rows_inserted AS \"Rows\",\n  COALESCE(error_message, '') AS \"Error\"\nFROM ingestion_log\nORDER BY started_at DESC\nLIMIT 20"
        }
      ],
